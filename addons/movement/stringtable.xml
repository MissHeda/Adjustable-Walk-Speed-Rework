            <English>speed %1  -  group %2  -  per-animation %3</English>
            <German>Speed %1  -  Gruppe %2  -  je Animation %3</German>
        </Key>
        <Key ID="STR_awsr_movement_DEBUG_noGroup">
            <English>none</English>
            <German>keine</German>
        </Key>
        <Key ID="STR_awsr_movement_DEBUG_noPinned">
            <English>not set</English>
            <German>nicht gesetzt</German>
        </Key>
        <Key ID="STR_awsr_movement_KEYBIND_autorun_stop">
            <English>Autorun | Stop</English>
            <German>Autolauf | Stopp</German>
        </Key>
        <Key ID="STR_awsr_movement_KEYBIND_autorun_stop_DESC">
            <English>Ends a running autorun.\nDoes nothing otherwise, so the key keeps\nits normal job.</English>
            <German>Beendet einen laufenden Autolauf.\nSonst passiert nichts, die Taste behält\nihre normale Funktion.</German>
        </Key>
        <Key ID="STR_awsr_movement_KEYBIND_autorun_nextAnimation">
            <English>Autorun | Next Animation</English>
            <German>Autolauf | Nächste Animation</German>
        </Key>
        <Key ID="STR_awsr_movement_KEYBIND_autorun_nextAnimation_DESC">
            <English>Steps through the alternatives listed for\nthe current pace, and back round.</English>
            <German>Schaltet durch die Alternativen der aktuellen\nGangart und wieder von vorn.</German>
        </Key>
        <Key ID="STR_awsr_movement_SETTING_IGUI_showAutorunPace">
            <English>Show Pace Text</English>
            <German>Gangart-Text anzeigen</German>
        </Key>
        <Key ID="STR_awsr_movement_SETTING_IGUI_showAutorunPace_DESC">
            <English>Shows the Walk / Jog / Run line\nabove the keys.</English>
            <German>Zeigt die Zeile Gehen / Joggen / Rennen\nüber den Tasten.</German>
        </Key>
        <Key ID="STR_awsr_movement_SETTING_IGUI_showAutorunKeys">
            <English>Show Keybinds</English>
            <German>Tastenbelegung anzeigen</German>
        </Key>
        <Key ID="STR_awsr_movement_SETTING_IGUI_showAutorunKeys_DESC">
            <English>Shows what the keys do under the pace.\nNames your own bindings, not the defaults.</English>
            <German>Zeigt unter der Gangart, was die Tasten tun.\nNennt deine eigene Belegung, nicht die Vorgabe.</German>
        </Key>
        <Key ID="STR_awsr_movement_SETTING_IGUI_Text_Autorun">
            <English>Keybind Line</English>
            <German>Tastenzeile</German>
        </Key>
        <Key ID="STR_awsr_movement_SETTING_IGUI_Text_Autorun_DESC">
            <English>How the parts of the keybind line are put\ntogether.\n\n%1 pace   %2 style   %3 stop\n\nEach part is worded in its own box below.\nA part with no key is left out whole, so\nput the spacing between parts at the end\nof those boxes.</English>
            <German>Wie die Teile der Tastenzeile zusammengesetzt\nwerden.\n\n%1 Gangart   %2 Stil   %3 Stopp\n\nJeder Teil wird unten einzeln formuliert.\nEin Teil ohne Taste fällt ganz weg - setze\nden Abstand zwischen den Teilen also ans\nEnde jener Felder.</German>
        </Key>
        <Key ID="STR_awsr_movement_SETTING_IGUI_TextPace_Autorun">
            <English>Keybind Line - Pace</English>
            <German>Tastenzeile - Gangart</German>
        </Key>
        <Key ID="STR_awsr_movement_SETTING_IGUI_TextStyle_Autorun">
            <English>Keybind Line - Style</English>
            <German>Tastenzeile - Stil</German>
        </Key>
        <Key ID="STR_awsr_movement_SETTING_IGUI_TextStop_Autorun">
            <English>Keybind Line - Stop</English>
            <German>Tastenzeile - Stopp</German>
        </Key>
        <Key ID="STR_awsr_movement_SETTING_IGUI_TextPart_Autorun_DESC">
            <English>%1 is the key or keys.\n\nLeft out entirely when there is no key,\nwhich is what keeps a label from standing\non its own.\n\nTrailing spaces separate it from the next\npart.</English>
            <German>%1 sind die Taste oder Tasten.\n\nFällt ganz weg, wenn es keine Taste gibt -\nso bleibt keine Beschriftung allein stehen.\n\nLeerzeichen am Ende trennen den Teil vom\nnächsten.</German>
        </Key>
        <Key ID="STR_awsr_movement_SETTING_IGUI_keyColor_Autorun">
            <English>Keybind Line - Key Colour</English>
            <German>Tastenzeile - Tastenfarbe</German>
        </Key>
        <Key ID="STR_awsr_movement_SETTING_IGUI_keyColor_Autorun_DESC">
            <English>Colour of the keys in the line.\nThe wording around them keeps the text colour.</English>
            <German>Farbe der Tasten in der Zeile.\nDie Beschriftung behält die Textfarbe.</German>
        </Key>
        <Key ID="STR_awsr_movement_SETTING_debug">
            <English>Debug: Collect Animation Names</English>
            <German>Debug: Animationsnamen sammeln</German>
        </Key>
        <Key ID="STR_awsr_movement_SETTING_debug_DESC">
            <English>Collects animation names.\n\n1. Switch on\n2. Do the move you want the name of\n3. Switch off and paste\n\nEvery animation is shown as you enter\nit, with the speed being applied to it\nand the group it belongs to.\n\nThe last 20 are in your clipboard,\ncomma separated - paste straight into a\nwhitelist or a speed box.\n\nWorks with the mod switched off.\nSwitches itself off in the next mission.</English>
            <German>Sammelt Animationsnamen.\n\n1. Einschalten\n2. Die Bewegung machen\n3. Ausschalten und einfügen\n\nJede Animation wird beim Wechsel\nangezeigt, mit ihrer Geschwindigkeit\nund ihrer Gruppe.\n\nDie letzten 20 liegen im Clipboard,\nper Komma getrennt - direkt in eine\nWhitelist oder ein Speed-Feld.\n\nGeht auch bei ausgeschaltetem Mod.\nSchaltet sich in der nächsten Mission\nselbst wieder aus.</German>
        </Key>
        <Key ID="STR_awsr_movement_DEBUG_title">
            <English>AWSR - Animation</English>
            <German>AWSR - Animation</German>
        </Key>
        <Key ID="STR_awsr_movement_DEBUG_copied">
            <English>Last %1 copied to your clipboard:</English>
            <German>Letzte %1 in der Zwischenablage:</German>
        </Key>
    </Package>
